{
    "providers": [
        {
            "http": {
                "name": "http",
                "listen_on": "0.0.0.0:8081",
                "endpoint": "/job/add"
            }
        },
        {
            "sqs": {
                "name": "sqs",
                "access_key": "",
                "secret_key": "",
                "region": "",
                "queue": "",
                "target": 10.0
            }
        }
    ],
    "workers": [
        {
            "cli": {
                "name": "cli",
                "workers": 1
            }
        },
        {
            "http": {
                "name": "http"
            }
        },
        {
            "file": {
                "name": "file",
                "root_folder": "jobs",
                "format": "tar"
            }
        }
    ],
    "failure_handler": [
        {
            "file": {
                "name": "failure",
                "root_folder": "failures",
                "raw": true
            }
        }
    ]
}
